# Copie para .env (ignorado pelo git). A URL é gravada no BUILD (Vite): termina com /api/v1/
VITE_API_URL=http://127.0.0.1:8000/api/v1/
# Opcional: domínios extras aceitos pelo servidor de desenvolvimento (separados por vírgula)
VITE_ALLOWED_HOSTS=localhost

# Observabilidade (opcional): DSN público do projeto React no Sentry
VITE_SENTRY_DSN=
VITE_APP_ENV=development
VITE_APP_VERSION=dev
VITE_SSO_ENABLED=false
